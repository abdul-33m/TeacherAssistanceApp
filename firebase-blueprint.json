{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Teacher account profile and workspace preferences stored privately per user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the teacher."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Teacher display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200,
          "description": "Teacher email address."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional avatar URL."
        },
        "activeAcademicYear": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "description": "Selected academic year label."
        },
        "activeClassId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Currently active class ID."
        },
        "isDarkMode": {
          "type": "boolean",
          "description": "Dark mode preference."
        },
        "cloudSyncKey": {
          "type": "string",
          "maxLength": 128,
          "description": "Legacy backup sync key."
        },
        "notificationEnabled": {
          "type": "boolean",
          "description": "Reminder notification preference."
        },
        "vaultSalt": {
          "type": "string",
          "maxLength": 256,
          "description": "Salt for E2EE notes vault."
        },
        "vaultVerifier": {
          "type": "string",
          "maxLength": 256,
          "description": "Passphrase verifier hash for E2EE vault."
        },
        "academicYears": {
          "type": "array",
          "description": "Configured academic years (max 20)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "email", "activeAcademicYear", "activeClassId", "isDarkMode", "notificationEnabled", "createdAt", "updatedAt"]
    },
